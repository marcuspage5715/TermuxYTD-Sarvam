#!/data/data/com.termux/files/usr/bin/bash
# TERMUX-YTD 2.0 — reviewed/fixed build
# Original by KhanSaad1275 (Saad Maqsood), MIT Licence
# https://github.com/khansaad1275/Termux-YTD2.0
#
# Changes vs. the original: ffmpeg is checked for before any download, every
# quality option actually requests that resolution, audio+video are always
# merged, exit status is reported, and a log is kept.

set -o pipefail

# ---------- settings you can change ----------
OUTDIR="$HOME/storage/shared/Youtube"
LOGFILE="$HOME/ytdl-last.log"
TMPDIR_YT="$HOME/.cache/ytdlp"
USE_INTERNAL_TEMP=0        # 1 = download fragments in internal storage, then move
MERGE_FORMAT="mp4/mkv"     # mp4 if possible, mkv otherwise
FRAGMENTS=4                # parallel fragments (raise to 8 on good Wi-Fi)
MAX_ATTEMPTS=3             # 1 try + 2 automatic retries
RETRY_WAITS="30 120 300"   # seconds to wait before retry 1, 2, 3
VERIFY_OUTPUT=1            # 1 = inspect the finished file with ffprobe
DURFILE="$HOME/.ytdl-expected-duration"
PATHFILE="$HOME/.ytdl-last-file"
EXPECT_VIDEO=1             # set to 0 for audio-only downloads
# ----------------------------------------------

# Errors that no amount of retrying will fix: bad format, private/removed video,
# bot check, bad URL. Anything else is treated as transient and retried.
FATAL_PATTERNS='Requested format is not available|Sign in to confirm|Private video|Video unavailable|This video is not available|members-only|Unsupported URL|not a valid URL|No video formats found|Incomplete YouTube ID|HTTP Error 404'

FTEMPLATE="$OUTDIR/%(title).150B [%(id)s].%(ext)s"

C_RED=$'\e[031m'; C_GRN=$'\e[032m'; C_YEL=$'\e[033m'; C_CYN=$'\e[036m'; C_OFF=$'\e[0m'

say()  { printf '%s%s%s\n' "$2" "$1" "$C_OFF"; }
pause_exit() {
  local code="${1:-0}"
  echo
  if [ "$code" -eq 0 ]; then
    say " ✔ All done. You can close Termux." "$C_GRN"
  else
    say " ✖ Finished with errors (exit $code). Full log: $LOGFILE" "$C_RED"
  fi
  say " Press Enter to close this session…" "$C_YEL"
  read -r _ 2>/dev/null || true
  exit "$code"
}

banner() {
  say " ▄ █   ▄▀▀▀▀▀▄   █ ▄   == Termux-YTD 2.0 ==" "$C_RED"
  say "▄▄▀▄   █─▀─▀─█  ▄▀▄▄   With Enhanced Speed" "$C_RED"
  say "     ▀▄▒▒▒▒▒▒▒▒▒▄▀    --------------------" "$C_RED"
  say "     █────▀────█       github.com/khansaad1275" "$C_RED"
  say "     █────▀────█       (reviewed build)" "$C_RED"
  say "╔════════════════════════════════════════╗" "$C_CYN"
  say "║ ♚ Project Name : TERMUX-YTD 2.0         ║" "$C_GRN"
  say "║ ♚ Author : KhanSaad1275                 ║" "$C_GRN"
  say "║ ♚ Website : www.LearnTermux.tech        ║" "$C_GRN"
  say "╠════════════════════════════════════════╝" "$C_CYN"
}

# ---------- sanity checks ----------
if [ "$#" -lt 1 ] || [ -z "$1" ]; then
  say "No URL given. Share a video from YouTube to Termux." "$C_RED"
  pause_exit 2
fi

URL="$1"

if ! command -v yt-dlp >/dev/null 2>&1; then
  say "yt-dlp is not installed. Run:  pkg install -y ffmpeg && pip install -U yt-dlp" "$C_RED"
  pause_exit 127
fi

# Without ffmpeg yt-dlp CANNOT merge video+audio and silently leaves two files.
if ! command -v ffmpeg >/dev/null 2>&1; then
  say "ffmpeg is missing — video and audio would be saved as two separate files." "$C_RED"
  say "Fix it with:  pkg install -y ffmpeg" "$C_YEL"
  say "Then run install.sh again, or install it now and press Enter to continue." "$C_YEL"
  read -r _ 2>/dev/null || true
  if ! command -v ffmpeg >/dev/null 2>&1; then
    say "Still no ffmpeg. Aborting instead of producing a split file." "$C_RED"
    pause_exit 3
  fi
fi

# ffprobe ships with the ffmpeg package and is what checks the finished file.
if [ "$VERIFY_OUTPUT" = "1" ] && ! command -v ffprobe >/dev/null 2>&1; then
  say "ffprobe is missing — the finished file will not be verified." "$C_YEL"
  say "It comes with ffmpeg:  pkg install -y ffmpeg" "$C_YEL"
  VERIFY_OUTPUT=0
fi

mkdir -p "$OUTDIR" 2>/dev/null || {
  say "Cannot create $OUTDIR — run 'termux-setup-storage' and allow storage." "$C_RED"
  pause_exit 4
}

# Warn when the target filesystem is nearly full (a 4 GB video needs ~12 GB
# while it downloads: video stream + audio stream + merged result).
FREE_KB=$(df -Pk "$OUTDIR" 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "${FREE_KB:-}" ] && [ "$FREE_KB" -lt 8000000 ]; then
  say "Warning: only $((FREE_KB / 1024)) MB free in $OUTDIR." "$C_YEL"
  say "A large video needs roughly 3x its size while merging." "$C_YEL"
fi

COMMON=(
  --no-playlist
  --retries 20
  --fragment-retries 20
  --retry-sleep 5
  --concurrent-fragments "$FRAGMENTS"
  --merge-output-format "$MERGE_FORMAT"
  --progress-delta 1
  --print-to-file "duration" "$DURFILE"
  --print-to-file "after_move:filepath" "$PATHFILE"
)
# On a terminal, yt-dlp's \r progress bar redraws one line — leave --newline off
# so it stays one line. Only switch to newline mode when output is redirected.
if [ ! -t 1 ]; then
  COMMON+=( --newline )
fi
if [ "$USE_INTERNAL_TEMP" = "1" ]; then
  mkdir -p "$TMPDIR_YT"
  COMMON+=( --paths "temp:$TMPDIR_YT" )
fi

# ---------- log helper ----------
tidy_log() {
  # The progress bar uses \r, which makes the log one huge line. Convert it and
  # keep only the last progress tick of each run so the log stays readable.
  [ -s "$LOGFILE" ] || return 0
  tr '\r' '\n' < "$LOGFILE" | awk '
    /^\[download\] +[0-9.]+%/ { last = $0; next }
    { if (last != "") { print last; last = "" } print }
    END { if (last != "") print last }
  ' > "$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
}

# ---------- verification ----------
fmt_dur() {  # seconds -> h:mm:ss
  awk -v s="$1" 'BEGIN {
    if (s == "" || s == "NA") { print "?"; exit }
    printf "%d:%02d:%02d", int(s / 3600), int((s % 3600) / 60), int(s % 60)
  }'
}

# Confirms the merged file is really complete: both streams present and the
# duration matching what yt-dlp said the source was. A truncated merge can still
# play for a few minutes, so exit code 0 alone is not proof.
verify_output() {
  local expect_video="$1" file expected actual vcodec acodec vres vrc newest

  file=$(tail -n 1 "$PATHFILE" 2>/dev/null)
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    newest=$(ls -t "$OUTDIR" 2>/dev/null | grep -viE '\.(part|ytdl|temp)$' | head -n 1)
    [ -n "$newest" ] && file="$OUTDIR/$newest"
  fi
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    say " ? Could not find the output file to verify." "$C_YEL"
    return 2
  fi

  acodec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name \
    -of default=nw=1:nk=1 "$file" 2>/dev/null)
  vcodec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name \
    -of default=nw=1:nk=1 "$file" 2>/dev/null)
  vres=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height \
    -of csv=s=x:p=0 "$file" 2>/dev/null)
  actual=$(ffprobe -v error -show_entries format=duration \
    -of default=nw=1:nk=1 "$file" 2>/dev/null)
  expected=$(head -n 1 "$DURFILE" 2>/dev/null)

  say " ✔ File  : $(basename "$file")" "$C_GRN"
  say "   Size  : $(du -h "$file" 2>/dev/null | cut -f1)" "$C_GRN"

  vrc=0
  if [ -n "$vcodec" ]; then
    say "   Video : $vcodec ${vres:+($vres)}" "$C_GRN"
  elif [ "$expect_video" = "1" ]; then
    say " ✖ No video stream in the output file." "$C_RED"
    vrc=1
  fi
  if [ -n "$acodec" ]; then
    say "   Audio : $acodec" "$C_GRN"
  else
    say " ✖ No audio stream in the output file." "$C_RED"
    vrc=1
  fi

  if printf '%s' "$actual" | grep -qE '^[0-9]+(\.[0-9]+)?$' &&
     printf '%s' "$expected" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
    if awk -v a="$actual" -v e="$expected" 'BEGIN {
         # 1% of the source length, never less than 3s: tight enough to catch a
         # truncated tail, loose enough to ignore container rounding.
         tol = e * 0.01
         if (tol < 3) tol = 3
         exit !(((a - e) < 0 ? e - a : a - e) <= tol) }'; then
      say "   Length: $(fmt_dur "$actual") — matches the source" "$C_GRN"
    else
      say " ✖ Length: $(fmt_dur "$actual") but the source is $(fmt_dur "$expected") — truncated." "$C_RED"
      vrc=1
    fi
  else
    say "   Length: $(fmt_dur "$actual") (source length unknown, not compared)" "$C_YEL"
  fi

  return "$vrc"
}

# ---------- downloader ----------
run_download() {
  local -a args=("${COMMON[@]}" "$@")
  local -a waits=($RETRY_WAITS)
  local rc=0 attempt=1 wait_secs start end secs total total_start fatal
  local attempt_log="$LOGFILE.attempt"

  echo
  say " ▶ yt-dlp ${args[*]}" "$C_CYN"
  say " ▶ saving to: $OUTDIR" "$C_CYN"
  say " ▶ log: $LOGFILE" "$C_CYN"

  total_start=$(date +%s)
  : > "$LOGFILE"
  : > "$DURFILE"
  : > "$PATHFILE"

  while : ; do
    if [ "$attempt" -gt 1 ]; then
      say " ↻ attempt ${attempt} of ${MAX_ATTEMPTS}" "$C_YEL"
    fi
    echo "=== attempt ${attempt} $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$LOGFILE"

    : > "$attempt_log"
    start=$(date +%s)
    yt-dlp "${args[@]}" 2>&1 | tee -a "$LOGFILE" "$attempt_log"
    rc=${PIPESTATUS[0]}
    end=$(date +%s); secs=$((end - start))

    # Judge only this attempt's output, then tidy the accumulated log.
    fatal=0
    if [ "$rc" -ne 0 ] && grep -qEi "$FATAL_PATTERNS" "$attempt_log" 2>/dev/null; then
      fatal=1
    fi
    tidy_log

    [ "$rc" -eq 0 ] && break

    if [ "$fatal" -eq 1 ]; then
      say " ✖ Permanent error (bad format, private or unavailable video, bot check)." "$C_RED"
      say "   Retrying would give the same result, so it stops here." "$C_YEL"
      break
    fi
    if [ "$attempt" -ge "$MAX_ATTEMPTS" ]; then
      say " ✖ Giving up after ${attempt} attempt(s)." "$C_RED"
      break
    fi

    wait_secs=${waits[$((attempt - 1))]:-300}
    say " ⏳ Failed after ${secs}s — retrying in ${wait_secs}s (attempt $((attempt + 1)) of ${MAX_ATTEMPTS})." "$C_YEL"
    say "    Partial data is kept, so the retry resumes where it stopped. Ctrl-C to stop." "$C_YEL"
    sleep "$wait_secs"
    attempt=$((attempt + 1))
  done

  total=$(( $(date +%s) - total_start ))
  rm -f "$attempt_log"

  echo
  say " ── yt-dlp exited with code $rc after ${total}s ──" "$C_CYN"

  if [ "$rc" -eq 0 ]; then
    local vrc=0 newest
    if [ "$VERIFY_OUTPUT" = "1" ]; then
      verify_output "$EXPECT_VIDEO"
      vrc=$?
    else
      vrc=3
      newest=$(ls -t "$OUTDIR" 2>/dev/null | grep -viE '\.(part|ytdl|temp)$' | head -n 1)
      if [ -n "$newest" ]; then
        say " ✔ Saved: $newest" "$C_GRN"
        say "   Size : $(du -h "$OUTDIR/$newest" 2>/dev/null | cut -f1)" "$C_GRN"
      fi
    fi
    case "$vrc" in
      0) say " ✔ DOWNLOAD COMPLETE — verified with ffprobe." "$C_GRN" ;;
      1) say " ✖ DOWNLOAD FINISHED, BUT VERIFICATION FAILED — the file may be incomplete." "$C_RED"
         say "   Delete it and share the video again; the download resumes from what is left." "$C_YEL"
         rc=5 ;;
      3) say " ✔ DOWNLOAD COMPLETE (verification off)." "$C_GRN" ;;
      *) say " ? DOWNLOAD COMPLETE (could not verify)." "$C_YEL" ;;
    esac
  else
    say " ✖ DOWNLOAD FAILED (exit $rc). Nothing was merged." "$C_RED"
    say "   Last lines of the log:" "$C_YEL"
    tail -n 15 "$LOGFILE" | sed 's/^/     /'
  fi
  return "$rc"
}

# ---------- shorts: one-click, but still merged ----------
if [[ "$URL" == *"shorts"* ]]; then
  run_download -f "bv*+ba/b" "$URL"
  pause_exit $?
fi

banner
say "╠═▶ [SELECT A FORMAT]  ➳" "$C_CYN"
say "╠═▶ 1. Music Mp3 ♫" "$C_GRN"
say "╠═▶ 2. Video 360p" "$C_GRN"
say "╠═▶ 3. Video 480p" "$C_GRN"
say "╠═▶ 4. Video 720p" "$C_GRN"
say "╠═▶ 5. Video 1080p" "$C_GRN"
say "╠═▶ 6. Video 1440p" "$C_GRN"
say "╠═▶ 7. Video 2160p (4K)" "$C_GRN"
say "╠═▶ 8. Best available" "$C_GRN"
say "╠═▶ 9. About" "$C_GRN"
say "╠═▶ 0. Exit Termux-YTD" "$C_GRN"
printf '%s ╚═:➤ %s' "$C_GRN" "$C_OFF"
read -r choice

# bv*[height<=N]+ba  -> separate video+audio streams, merged by ffmpeg.
# /b[height<=N]      -> fallback for sites that only offer combined files.
pick_video() {
  local h="$1"
  run_download -f "bv*[height<=${h}]+ba/b[height<=${h}]" "$URL"
}

case "$choice" in
  1)
    EXPECT_VIDEO=0
    run_download -f "ba/b" -x --audio-format mp3 --audio-quality 0 \
      --embed-thumbnail --embed-metadata --convert-thumbnails jpg "$URL"
    ;;
  2) pick_video 360 ;;
  3) pick_video 480 ;;
  4) pick_video 720 ;;
  5) pick_video 1080 ;;
  6) pick_video 1440 ;;
  7) pick_video 2160 ;;
  8) run_download -f "bv*+ba/b" "$URL" ;;
  9)
    say "Termux-YTD 2.0 downloads any YouTube video, music or short with two taps." "$C_CYN"
    say "Share a video from the YouTube app, choose Termux, then pick a quality." "$C_CYN"
    say "Every download is written to: $OUTDIR" "$C_CYN"
    say "Full log of the last download: $LOGFILE" "$C_CYN"
    pause_exit 0
    ;;
  0)
    say "Bye." "$C_GRN"
    exit 0
    ;;
  *)
    say "Invalid choice: '$choice'. Nothing downloaded." "$C_RED"
    pause_exit 1
    ;;
esac

pause_exit $?
